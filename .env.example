# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The live site address (Victor to confirm .co.ke or .com)
NEXT_PUBLIC_SITE_URL=https://platinummarketingagency.co.ke

# ANALYTICS: Umami Cloud (free Hobby plan, no cookies). Leave empty to switch analytics off.
# umami.is -> Add website -> copy the "Website ID".
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# CONTACT FORM: set at least one of these, or the form can't deliver in production.
# (In development, with none set, submissions are printed in the terminal.)
# Submissions go to Platinum only. Nothing is ever sent to the person who filled in the form.

# Option A: Google Sheets. A Google Apps Script "web app" URL that adds a row (see README).
GOOGLE_SHEETS_WEBHOOK_URL=

# Option B: email via Resend (resend.com). Key from the Resend dashboard.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Website <website@platinummarketingagency.co.ke>"
CONTACT_FROM_EMAIL=
